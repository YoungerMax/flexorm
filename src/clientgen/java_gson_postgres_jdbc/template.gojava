    static class ExpressionToSql {
        public static void expressionToSql(SqlExpression expr, SqlBuilder builder) {
            expressionToSqlWithQualify(expr, builder, false);
        }

        public static void expressionToSql(SqlExpression expr, SqlBuilder builder, boolean qualifyColumns) {
            expressionToSqlWithQualify(expr, builder, qualifyColumns);
        }

        private static void expressionToSqlWithQualify(SqlExpression expr, SqlBuilder builder, boolean qualifyColumns) {
            if (expr instanceof BiColumnSqlOperation) {
                BiColumnSqlOperation<?> binOp = (BiColumnSqlOperation<?>) expr;
                builder.append("\"").append(qualifyColumns ? binOp.getLeft().name : binOp.getLeft().column).append("\"");

                if (expr instanceof Equal) {
                    builder.append(" = ");
                } else if (expr instanceof NotEqual) {
                    builder.append(" != ");
                } else if (expr instanceof GreaterThan) {
                    builder.append(" > ");
                } else if (expr instanceof GreaterThanOrEqual) {
                    builder.append(" >= ");
                } else if (expr instanceof LessThan) {
                    builder.append(" < ");
                } else if (expr instanceof LessThanOrEqual) {
                    builder.append(" <= ");
                } else if (expr instanceof Like) {
                    builder.append(" LIKE ");
                } else if (expr instanceof ILike) {
                    builder.append(" ILIKE ");
                } else if (expr instanceof In) {
                    builder.append(" IN ");
                } else if (expr instanceof NotIn) {
                    builder.append(" NOT IN ");
                }

                Object right = binOp.getRight();
                if (right instanceof Column) {
                    builder.append("\"").append(qualifyColumns ? ((Column<?>) right).name : ((Column<?>) right).column).append("\"");
                } else if (right instanceof List) {
                    builder.append("(");
                    List<?> list = (List<?>) right;
                    for (int i = 0; i < list.size(); i++) {
                        if (i > 0) builder.append(", ");
                        builder.appendParameter(list.get(i));
                    }
                    builder.append(")");
                } else {
                    builder.appendParameter(right);
                }
            } else if (expr instanceof ColumnSqlOperation) {
                ColumnSqlOperation<?> colOp = (ColumnSqlOperation<?>) expr;
                builder.append("\"").append(qualifyColumns ? colOp.getColumn().name : colOp.getColumn().column).append("\"");
                if (expr instanceof IsNull) {
                    builder.append(" IS NULL");
                } else if (expr instanceof IsNotNull) {
                    builder.append(" IS NOT NULL");
                }
            } else if (expr instanceof MultipleSqlOperation) {
                MultipleSqlOperation multiOp = (MultipleSqlOperation) expr;
                List<SqlExpression> operators = multiOp.getOperators();
                builder.append("(");
                for (int i = 0; i < operators.size(); i++) {
                    if (i > 0) {
                        if (expr instanceof And) {
                            builder.append(" AND ");
                        } else if (expr instanceof Or) {
                            builder.append(" OR ");
                        }
                    }
                    expressionToSqlWithQualify(operators.get(i), builder, qualifyColumns);
                }
                builder.append(")");
            }
        }
    }

