    public void executeUpdate(String sql, Object... params) throws SQLException {
        try (PreparedStatement stmt = connection.prepareStatement(sql)) {
            for (int i = 0; i < params.length; i++) {
                stmt.setObject(i + 1, params[i]);
            }
            stmt.executeUpdate();
        }
    }

    public <T> List<T> executeQuery(String sql, java.util.function.Function<ResultSet, T> mapper, Object... params) throws SQLException {
        try (PreparedStatement stmt = connection.prepareStatement(sql)) {
            for (int i = 0; i < params.length; i++) {
                stmt.setObject(i + 1, params[i]);
            }
            ResultSet rs = stmt.executeQuery();
            List<T> results = new ArrayList<>();
            while (rs.next()) {
                results.add(mapper.apply(rs));
            }
            return results;
        }
    }

    public static abstract class QueryBuilder {
        protected Table table;

        public QueryBuilder(Table table) {
            this.table = table;
        }

        protected abstract SqlBuilder toSql();
    }

    public static class SelectBuilder<T> extends QueryBuilder {
        private List<Column<?>> columns = new ArrayList<>();
        private boolean distinct = false;
        private SqlExpression where;
        private List<Column<?>> groupBy = new ArrayList<>();
        private SqlExpression having;
        private List<OrderExpression> orderBy = new ArrayList<>();
        private Integer limit;
        private Integer offset;
        private List<Join> joins = new ArrayList<>();
        private List<UnionExpression> unions = new ArrayList<>();

        public SelectBuilder(Table table, Column<?>... columns) {
            super(table);
            if (columns.length > 0) {
                this.columns.addAll(Arrays.asList(columns));
            }
        }

        public SelectBuilder<T> distinct() {
            this.distinct = true;
            return this;
        }

        public SelectBuilder<T> where(SqlExpression condition) {
            this.where = condition;
            return this;
        }

        public SelectBuilder<T> groupBy(Column<?>... columns) {
            this.groupBy.addAll(Arrays.asList(columns));
            return this;
        }

        public SelectBuilder<T> having(SqlExpression condition) {
            this.having = condition;
            return this;
        }

        public SelectBuilder<T> orderBy(Column<?> column, String direction) {
            this.orderBy.add(new OrderExpression(column, direction));
            return this;
        }

        public SelectBuilder<T> limit(int limit) {
            this.limit = limit;
            return this;
        }

        public SelectBuilder<T> offset(int offset) {
            this.offset = offset;
            return this;
        }

        public SelectBuilder<T> innerJoin(Table joinTable, SqlExpression condition) {
            this.joins.add(new Join(Join.JoinType.INNER, joinTable, condition));
            return this;
        }

        public SelectBuilder<T> leftJoin(Table joinTable, SqlExpression condition) {
            this.joins.add(new Join(Join.JoinType.LEFT, joinTable, condition));
            return this;
        }

        public SelectBuilder<T> rightJoin(Table joinTable, SqlExpression condition) {
            this.joins.add(new Join(Join.JoinType.RIGHT, joinTable, condition));
            return this;
        }

        public SelectBuilder<T> fullJoin(Table joinTable, SqlExpression condition) {
            this.joins.add(new Join(Join.JoinType.FULL, joinTable, condition));
            return this;
        }

        public SelectBuilder<T> union(SelectBuilder query) {
            this.unions.add(new UnionExpression(query, false));
            return this;
        }

        public SelectBuilder<T> unionAll(SelectBuilder query) {
            this.unions.add(new UnionExpression(query, true));
            return this;
        }

        protected SqlBuilder toSql() {
            SqlBuilder builder = new SqlBuilder();

            // SELECT
            builder.append("SELECT ");
            if (distinct) {
                builder.append("DISTINCT ");
            }

            if (columns.isEmpty()) {
                builder.append("*");
            } else {
                StringBuilder colBuilder = new StringBuilder();
                for (int i = 0; i < columns.size(); i++) {
                    if (i > 0) {
                        colBuilder.append(", ");
                    }
                    colBuilder.append("\"").append(columns.get(i).column).append("\"");
                }
                builder.append(colBuilder.toString());
            }

            // FROM
            builder.append(" FROM \"").append(table.tableName).append("\"");

            // JOINS
            for (Join join : joins) {
                switch (join.type) {
                    case INNER:
                        builder.append(" INNER JOIN ");
                        break;
                    case LEFT:
                        builder.append(" LEFT JOIN ");
                        break;
                    case RIGHT:
                        builder.append(" RIGHT JOIN ");
                        break;
                    case FULL:
                        builder.append(" FULL JOIN ");
                        break;
                }
                builder.append("\"").append(join.table.tableName).append("\"");
                if (join.condition != null) {
                    builder.append(" ON ");
                    ExpressionToSql.expressionToSql(join.condition, builder, true);
                }
            }

            // WHERE
            if (where != null) {
                builder.append(" WHERE ");
                ExpressionToSql.expressionToSql(where, builder);
            }

            // GROUP BY
            if (!groupBy.isEmpty()) {
                builder.append(" GROUP BY ");
                StringBuilder groupBuilder = new StringBuilder();
                for (int i = 0; i < groupBy.size(); i++) {
                    if (i > 0) {
                        groupBuilder.append(", ");
                    }
                    groupBuilder.append("\"").append(groupBy.get(i).column).append("\"");
                }
                builder.append(groupBuilder.toString());
            }

            // HAVING
            if (having != null) {
                builder.append(" HAVING ");
                ExpressionToSql.expressionToSql(having, builder, !groupBy.isEmpty());
            }

            // ORDER BY
            if (!orderBy.isEmpty()) {
                builder.append(" ORDER BY ");
                StringBuilder orderBuilder = new StringBuilder();
                for (int i = 0; i < orderBy.size(); i++) {
                    if (i > 0) {
                        orderBuilder.append(", ");
                    }
                    OrderExpression expr = orderBy.get(i);
                    orderBuilder.append("\"").append(expr.column.column).append("\" ").append(expr.direction);
                }
                builder.append(orderBuilder.toString());
            }

            // LIMIT
            if (limit != null) {
                builder.append(" LIMIT ").append(String.valueOf(limit));
            }

            // OFFSET
            if (offset != null) {
                builder.append(" OFFSET ").append(String.valueOf(offset));
            }

            // UNION
            for (UnionExpression union : unions) {
                builder.append(union.all ? " UNION ALL " : " UNION ");
                SqlBuilder unionBuilder = union.query.toSql();
                builder.append("(" + unionBuilder.getSql() + ")");
            }

            return builder;
        }

        public List<T> execute() throws SQLException {
            SqlBuilder builder = toSql();
            try (PreparedStatement stmt = table.orm.getConnection().prepareStatement(builder.getSql())) {
                Object[] params = builder.getParameters();
                for (int i = 0; i < params.length; i++) {
                    stmt.setObject(i + 1, params[i]);
                }
                ResultSet rs = stmt.executeQuery();
                List<T> results = new ArrayList<>();
                while (rs.next()) {
                    results.add((T) table.deserializeRow(rs));
                }
                return results;
            }
        }
    }

    static class OrderExpression {
        public Column<?> column;
        public String direction;

        public OrderExpression(Column<?> column, String direction) {
            this.column = column;
            this.direction = direction;
        }
    }

    static class UnionExpression {
        public SelectBuilder query;
        public boolean all;

        public UnionExpression(SelectBuilder query, boolean all) {
            this.query = query;
            this.all = all;
        }
    }

    public static class InsertBuilder<T> extends QueryBuilder {
        private Object values;
        private ConflictAction conflictAction;

        public InsertBuilder(Table table, Object values) {
            super(table);
            this.values = values;
        }

        public InsertBuilder onConflictDoNothing(String... targets) {
            this.conflictAction = new ConflictAction(ConflictAction.Type.NOTHING, null, targets);
            return this;
        }

        public InsertBuilder onConflictDoUpdate(Object updateSet, String... targets) {
            this.conflictAction = new ConflictAction(ConflictAction.Type.UPDATE, updateSet, targets);
            return this;
        }

        protected SqlBuilder toSql() {
            SqlBuilder builder = new SqlBuilder();
            builder.append("INSERT INTO \"").append(table.tableName).append("\"");

            // Get column names and values
            List<ColumnValue> columnValues = table.serializeForUpdate(values);
            if (!columnValues.isEmpty()) {
                StringBuilder colBuilder = new StringBuilder();
                for (int i = 0; i < columnValues.size(); i++) {
                    if (i > 0) {
                        colBuilder.append(", ");
                    }
                    colBuilder.append("\"").append(columnValues.get(i).columnName).append("\"");
                }
                builder.append(" (").append(colBuilder.toString()).append(")");

                builder.append(" VALUES (");
                for (int i = 0; i < columnValues.size(); i++) {
                    if (i > 0) {
                        builder.append(", ");
                    }
                    builder.appendParameter(columnValues.get(i).value);
                }
                builder.append(")");
            } else {
                builder.append(" DEFAULT VALUES");
            }

            // ON CONFLICT
            if (conflictAction != null) {
                builder.append(" ON CONFLICT");
                if (conflictAction.targets != null && conflictAction.targets.length > 0) {
                    builder.append(" (");
                    for (int i = 0; i < conflictAction.targets.length; i++) {
                        if (i > 0) {
                            builder.append(", ");
                        }
                        builder.append("\"").append(conflictAction.targets[i]).append("\"");
                    }
                    builder.append(")");
                }
                if (conflictAction.type == ConflictAction.Type.NOTHING) {
                    builder.append(" DO NOTHING");
                } else if (conflictAction.type == ConflictAction.Type.UPDATE) {
                    List<ColumnValue> updateValues = table.serializeForUpdate(conflictAction.updateSet);
                    builder.append(" DO UPDATE SET ");
                    for (int i = 0; i < updateValues.size(); i++) {
                        if (i > 0) {
                            builder.append(", ");
                        }
                        builder.append("\"").append(updateValues.get(i).columnName)
                                   .append("\" = ");
                        if (updateValues.get(i).value != null) {
                            builder.appendParameter(updateValues.get(i).value);
                        } else {
                            builder.append("NULL");
                        }
                    }
                }
            }

            return builder;
        }

        public void execute() throws SQLException {
            SqlBuilder builder = toSql();
            try (PreparedStatement stmt = table.orm.getConnection().prepareStatement(builder.getSql())) {
                Object[] params = builder.getParameters();
                for (int i = 0; i < params.length; i++) {
                    stmt.setObject(i + 1, params[i]);
                }
                stmt.executeUpdate();
            }
        }

        public List<T> executeReturning() throws SQLException {
            SqlBuilder builder = toSql();
            builder.append(" RETURNING *");
            try (PreparedStatement stmt = table.orm.getConnection().prepareStatement(builder.getSql())) {
                Object[] params = builder.getParameters();
                for (int i = 0; i < params.length; i++) {
                    stmt.setObject(i + 1, params[i]);
                }
                ResultSet rs = stmt.executeQuery();
                List<T> results = new ArrayList<>();
                while (rs.next()) {
                    results.add((T) table.deserializeRow(rs));
                }
                return results;
            }
        }

        private static class ConflictAction {
            enum Type { NOTHING, UPDATE }
            Type type;
            Object updateSet;
            String[] targets;

            ConflictAction(Type type, Object updateSet, String[] targets) {
                this.type = type;
                this.updateSet = updateSet;
                this.targets = targets;
            }
        }
    }

    public static class UpdateBuilder extends QueryBuilder {
        private Object values;
        private SqlExpression where;

        public UpdateBuilder(Table table, Object values) {
            super(table);
            this.values = values;
        }

        public UpdateBuilder where(SqlExpression condition) {
            this.where = condition;
            return this;
        }

        protected SqlBuilder toSql() {
            SqlBuilder builder = new SqlBuilder();
            builder.append("UPDATE \"").append(table.tableName).append("\" SET ");

            List<ColumnValue> columnValues = table.serializeForUpdate(values);
            for (int i = 0; i < columnValues.size(); i++) {
                if (i > 0) {
                    builder.append(", ");
                }
                builder.append("\"").append(columnValues.get(i).columnName).append("\" = ");
                if (columnValues.get(i).value != null) {
                    builder.appendParameter(columnValues.get(i).value);
                } else {
                    builder.append("NULL");
                }
            }

            // WHERE
            if (where != null) {
                builder.append(" WHERE ");
                ExpressionToSql.expressionToSql(where, builder);
            }

            return builder;
        }

        public int execute() throws SQLException {
            SqlBuilder builder = toSql();
            try (PreparedStatement stmt = table.orm.getConnection().prepareStatement(builder.getSql())) {
                Object[] params = builder.getParameters();
                for (int i = 0; i < params.length; i++) {
                    stmt.setObject(i + 1, params[i]);
                }
                return stmt.executeUpdate();
            }
        }
    }

    public static class DeleteBuilder extends QueryBuilder {
        private SqlExpression where;
        private Table using;

        public DeleteBuilder(Table table) {
            super(table);
        }

        public DeleteBuilder where(SqlExpression condition) {
            this.where = condition;
            return this;
        }

        public DeleteBuilder using(Table usingTable) {
            this.using = usingTable;
            return this;
        }

        protected SqlBuilder toSql() {
            SqlBuilder builder = new SqlBuilder();
            builder.append("DELETE FROM \"").append(table.tableName).append("\"");

            // USING
            if (using != null) {
                builder.append(" USING \"").append(using.tableName).append("\"");
            }

            // WHERE
            if (where != null) {
                builder.append(" WHERE ");
                ExpressionToSql.expressionToSql(where, builder, using != null);
            }

            return builder;
        }

        public int execute() throws SQLException {
            SqlBuilder builder = toSql();
            try (PreparedStatement stmt = table.orm.getConnection().prepareStatement(builder.getSql())) {
                Object[] params = builder.getParameters();
                for (int i = 0; i < params.length; i++) {
                    stmt.setObject(i + 1, params[i]);
                }
                return stmt.executeUpdate();
            }
        }
    }

