{{- if or .Nullable .HasDefault}}
        if (obj.{{.ColName}} != null) {
            if (!(obj.{{.ColName}} instanceof Point)) {
                throw new IllegalArgumentException("{{.ColName}} must be a Point");
            }
        }
{{else}}
        if (obj.{{.ColName}} == null) {
            throw new IllegalArgumentException("{{.ColName}} is required");
        }
        if (!(obj.{{.ColName}} instanceof Point)) {
            throw new IllegalArgumentException("{{.ColName}} must be a Point");
        }
{{- end}}