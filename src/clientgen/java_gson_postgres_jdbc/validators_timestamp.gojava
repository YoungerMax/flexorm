{{- if or .Nullable .HasDefault}}
        if (obj.{{.ColName}} != null) {
            if (!(obj.{{.ColName}} instanceof java.time.Instant)) {
                throw new IllegalArgumentException("{{.ColName}} must be an Instant");
            }
        }
{{else}}
        if (obj.{{.ColName}} == null) {
            throw new IllegalArgumentException("{{.ColName}} is required");
        }
        if (!(obj.{{.ColName}} instanceof java.time.Instant)) {
            throw new IllegalArgumentException("{{.ColName}} must be an Instant");
        }
{{- end}}