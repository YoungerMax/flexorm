{{- if or .Nullable .HasDefault}}
        if (obj.{{.ColName}} != null) {
{{else}}
        if (obj.{{.ColName}} == null) {
            throw new IllegalArgumentException("{{.ColName}} is required");
        } else {
{{- end}}
            if (!(obj.{{.ColName}} instanceof String)) {
                throw new IllegalArgumentException("{{.ColName}} must be a String");
            }
{{- if .HasMaxLength}}
            if (((String) obj.{{.ColName}}).length() > {{.MaxLength}}) {
                throw new IllegalArgumentException("{{.ColName}} must be at most {{.MaxLength}} characters");
            }
{{- end}}
{{- if .HasPattern}}
            if (!_pattern_{{.ColName}}.matcher((String) obj.{{.ColName}}).matches()) {
                throw new IllegalArgumentException("{{.ColName}} does not match required pattern");
            }
{{- end}}
        }