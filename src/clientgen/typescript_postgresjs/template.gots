import postgres from "postgres";

interface FColumn<ColumnType> {
    name: string;
}

type FSql = FBiColumnSqlType<any> | FColumnSqlType<any> | FMultipleSqlType;

class FBiColumnSqlType<ColumnType> {
    left: FColumn<ColumnType>;
    right: FColumn<ColumnType> | ColumnType;

    constructor(left: FColumn<ColumnType>, right: FColumn<ColumnType> | ColumnType) {
        this.left = left;
        this.right = right;
    }
}

class FColumnSqlType<ColumnType> {
    column: FColumn<ColumnType>;

    constructor(column: FColumn<any>) {
        this.column = column;
    }
}

class FMultipleSqlType {
    operators: FSql[];

    constructor(...operators: FSql[]) {
        this.operators = operators;
    }
}

export class NotEqual<ColumnType> extends FBiColumnSqlType<ColumnType> { }
export class Equal<ColumnType> extends FBiColumnSqlType<ColumnType> { }
export class GreaterThan<ColumnType> extends FBiColumnSqlType<ColumnType> { }
export class GreaterThanOrEqual<ColumnType> extends FBiColumnSqlType<ColumnType> { }
export class LessThan<ColumnType> extends FBiColumnSqlType<ColumnType> { }
export class LessThanOrEqual<ColumnType> extends FBiColumnSqlType<ColumnType> { }
export class Like<ColumnType> extends FBiColumnSqlType<ColumnType> { }
export class ILike<ColumnType> extends FBiColumnSqlType<ColumnType> { }
export class In<ColumnType> extends FBiColumnSqlType<ColumnType[]> { }
export class NotIn<ColumnType> extends FBiColumnSqlType<ColumnType[]> { }

export class And extends FMultipleSqlType { }
export class Or extends FMultipleSqlType { }

export class IsNull extends FColumnSqlType<any> { }
export class IsNotNull extends FColumnSqlType<any> { }

class FTable {
    _orm: FlexORM;
    $$name: string;

    constructor(orm: FlexORM, $$name: string) {
        this._orm = orm;
        this.$$name = $$name;
    }
}

type JoinType = 'LEFT' | 'RIGHT' | 'INNER' | 'FULL' | 'CROSS';

interface Join {
    type: JoinType;
    table: FTable;
    condition?: FSql;
}

function toIdentifier(sql: postgres.Sql<{}>, col: FColumn<any> | string): postgres.Helper<string, any> {
    return sql(typeof col === 'string' ? col : col.name);
}

// Helper function to check if a value is an FColumn
function isColumn(value: any): value is FColumn<any> {
    return value && typeof value === 'object' && 'name' in value && typeof value.name === 'string';
}

function expressionToSql(sql: postgres.Sql<{}>, expression: FSql): postgres.PendingQuery<any> {
    if (expression instanceof And || expression instanceof Or) {
        if (expression.operators.length === 0) {
            throw new Error(`${expression instanceof And ? 'AND' : 'OR'} operator requires at least one operand`);
        }

        const operator = expression instanceof And ? sql` AND ` : sql` OR `;
        const fragments = expression.operators.map(op => expressionToSql(sql, op));

        // Join the fragments with the SQL-tagged operator
        const joined = fragments.reduce((acc, curr) => sql`${acc}${operator}${curr}`);

        return sql`(${joined})`;
    }

    if (expression instanceof IsNull) {
        return sql`${toIdentifier(sql, expression.column)} IS NULL`;
    }

    if (expression instanceof IsNotNull) {
        return sql`${toIdentifier(sql, expression.column)} IS NOT NULL`;
    }

    if (expression instanceof FBiColumnSqlType) {
        const column = toIdentifier(sql, expression.left);
        const value = expression.right;

        const operatorMap: Record<string, string> = {
            [Equal.name]: '=',
            [NotEqual.name]: '!=',
            [GreaterThan.name]: '>',
            [GreaterThanOrEqual.name]: '>=',
            [LessThan.name]: '<',
            [LessThanOrEqual.name]: '<=',
            [Like.name]: 'LIKE',
            [ILike.name]: 'ILIKE',
        };

        const op = operatorMap[expression.constructor.name];

        if (op) {
            // Check if right side is a column or a value
            if (isColumn(value)) {
                return sql`${column} ${sql.unsafe(op)} ${toIdentifier(sql, value)}`;
            } else {
                return sql`${column} ${sql.unsafe(op)} ${value}`;
            }
        }

        if (expression instanceof In) {
            return sql`${column} IN ${sql(value as any[])}`;
        }

        if (expression instanceof NotIn) {
            return sql`${column} NOT IN ${sql(value as any[])}`;
        }
    }

    throw new Error(`Unknown expression type: ${expression.constructor.name}`);
}

abstract class QueryBuilder {
    protected _table: FTable;
    
    constructor(table: FTable) {
        this._table = table;
    }
    
    then<T = any>(
        onfulfilled?: ((value: T[]) => T[] | PromiseLike<T[]>) | null,
        onrejected?: ((err: Error) => never | PromiseLike<never>) | null
    ): Promise<T[]> {
        try {
            return this.toSql().then(onfulfilled, onrejected);
        } catch (err) {
            return Promise.reject(err).then(onfulfilled, onrejected);
        }
    }
    
    catch(onrejected?: ((err: Error) => never | PromiseLike<never>) | null) {
        return this.then(null, onrejected);
    }
    
    finally(onfinally?: (() => void) | null) {
        return this.then(
            (value) => { onfinally?.(); return value; },
            (reason) => { onfinally?.(); throw reason; }
        );
    }
    
    protected abstract toSql(): postgres.PendingQuery<any>;
}

class SelectBuilder extends QueryBuilder {
    private _columns: Array<FColumn<any> | string> = [];
    private _distinct = false;
    private _where?: FSql;
    private _groupBy: Array<FColumn<any> | string> = [];
    private _having?: FSql;
    private _orderBy: Array<{ column: FSql | string; direction: 'ASC' | 'DESC' }> = [];
    private _limit?: number;
    private _offset?: number;
    private _joins: Join[] = [];
    private _unions: Array<{ query: SelectBuilder; all: boolean }> = [];

    constructor(table: FTable, ...columns: Array<FColumn<any> | string>) {
        super(table);
        this._columns.push(...columns);
    }

    distinct() { this._distinct = true; return this; }
    where(condition: FSql) { this._where = condition; return this; }
    groupBy(...columns: Array<FColumn<any> | string>) { this._groupBy.push(...columns); return this; }
    having(condition: FSql) { this._having = condition; return this; }
    orderBy(column: FSql | string, direction: 'ASC' | 'DESC' = 'ASC') { this._orderBy.push({ column, direction }); return this; }
    limit(limit: number) { this._limit = limit; return this; }
    offset(offset: number) { this._offset = offset; return this; }
    join(type: JoinType, table: FTable, condition?: FSql) { this._joins.push({ type, table, condition }); return this; }
    leftJoin(table: FTable, condition: FSql) { return this.join('LEFT', table, condition); }
    rightJoin(table: FTable, condition: FSql) { return this.join('RIGHT', table, condition); }
    innerJoin(table: FTable, condition: FSql) { return this.join('INNER', table, condition); }
    fullJoin(table: FTable, condition: FSql) { return this.join('FULL', table, condition); }
    crossJoin(table: FTable) { return this.join('CROSS', table); }
    union(query: SelectBuilder) { this._unions.push({ query, all: false }); return this; }
    unionAll(query: SelectBuilder) { this._unions.push({ query, all: true }); return this; }

    toSql(): postgres.PendingQuery<any> {
        let sql = this._table._orm._sql;

        // SELECT, FROM, and DISTINCT clauses
        let query;

        const selectCols = this._columns.length > 0
            ? sql.unsafe(this._columns.map(c => typeof c === 'string' ? c : c.name).join(', '))
            : sql`*`;

        if (this._distinct) {
            query = sql`SELECT DISTINCT ${selectCols} FROM ${sql.unsafe(this._table.$$name)}`;
        } else {
            query = sql`SELECT ${selectCols} FROM ${sql.unsafe(this._table.$$name)}`;
        }

        // JOIN clauses
        for (const join of this._joins) {
            if (join.type === 'CROSS') {
                query = sql`${query} CROSS JOIN ${sql.unsafe(join.table.$$name)}`;
            } else if (join.condition) {
                query = sql`${query} ${sql.unsafe(join.type)} JOIN ${sql.unsafe(join.table.$$name)} ON ${expressionToSql(sql, join.condition)}`;
            }
        }

        // WHERE clause 
        if (this._where) {
            query = sql`${query} WHERE ${expressionToSql(sql, this._where)}`;
        }

        // GROUP BY clause
        if (this._groupBy.length > 0) {
            const groupCols = this._groupBy.map(column => typeof column === 'string' ? column : column.name).join(', ');

            query = sql`${query} GROUP BY ${sql.unsafe(groupCols)}`;
        }

        // HAVING clause
        if (this._having) {
            query = sql`${query} HAVING ${expressionToSql(sql, this._having)}`;
        }

        // ORDER BY clause
        if (this._orderBy.length > 0) {
            const orderParts = this._orderBy.map(o => {
                const colName = typeof o.column === 'string' ? o.column : (o.column as any).name;
                return `"${colName}" ${o.direction}`;
            }).join(', ');

            query = sql`${query} ORDER BY ${sql.unsafe(orderParts)}`;
        }

        // LIMIT clause
        if (this._limit) {
            query = sql`${query} LIMIT ${this._limit}`;
        }

        // OFFSET clause
        if (this._offset) {
            query = sql`${query} OFFSET ${this._offset}`;
        }

        // UNION clauses
        for (const union of this._unions) {
            const unionKeyword = union.all ? 'UNION ALL' : 'UNION';
            const unionQuery = union.query.toSql();
            query = sql`${query} ${sql.unsafe(unionKeyword)} (${unionQuery})`;
        }

        return query;
    }
}

class InsertBuilder extends QueryBuilder {
    private _values: Array<Record<string, any>> = [];
    private _onConflict?: { target?: string | string[]; action: 'NOTHING' | 'UPDATE'; updateSet?: Record<string, any>; };
    private _returning: Array<FColumn<any> | string> = [];

    constructor(table: FTable, values: Record<string, any> | Array<Record<string, any>>) {
        super(table);

        if (Array.isArray(values)) { 
            this._values.push(...values);
        } else {
            this._values.push(values);
        }
    }

    onConflictDoNothing(target?: string | string[]) { this._onConflict = { target, action: 'NOTHING' }; return this; }
    onConflictDoUpdate(target: string | string[], updateSet: Record<string, any>) { this._onConflict = { target, action: 'UPDATE', updateSet }; return this; }
    returning(...columns: Array<FColumn<any> | string>) {this._returning.push(...columns); return this; }

    toSql(): postgres.PendingQuery<any> {
        if (this._values.length === 0) {
            throw new Error('INSERT requires values');
        }

        let sql = this._table._orm._sql;

        // INSERT INTO builder
        let query = sql`INSERT INTO ${sql.unsafe(this._table.$$name)} ${sql(this._values)}`;

        // ON CONFLICT builder
        if (this._onConflict) {
            const { target, action, updateSet } = this._onConflict;
            query = sql`${query} ON CONFLICT`;
            
            // build the target list
            if (target) {
                const targetList = Array.isArray(target) ? sql(target) : sql([target]);
                query = sql`${query} (${targetList})`;
            }

            // builder the action
            if (action === 'NOTHING') {
                query = sql`${query} DO NOTHING`;
            } else if (action === 'UPDATE' && updateSet) {
                query = sql`${query} DO UPDATE SET ${sql(updateSet)}`;
            }
        }

        // RETURNING builder
        if (this._returning.length > 0) {
            const colNames = this._returning.map(c => typeof c === 'string' ? c : c.name).join(', ');
            query = sql`${query} RETURNING ${sql.unsafe(colNames)}`;
        }

        return query;
    }
}

class UpdateBuilder extends QueryBuilder {
    private _set: Record<string, any> = {};
    private _where?: FSql;
    private _returning: Array<FColumn<any> | string> = [];

    set(values: Record<string, any>) { this._set = { ...this._set, ...values }; return this; }
    where(condition: FSql) { this._where = condition; return this; }
    returning(...columns: Array<FColumn<any> | string>) { this._returning.push(...columns); return this; }

    toSql(): postgres.PendingQuery<any> {
        if (Object.keys(this._set).length === 0) {
            throw new Error('UPDATE requires SET');
        }

        let sql = this._table._orm._sql;

        let query = sql`UPDATE ${sql.unsafe(this._table.$$name)} SET ${sql(this._set)}`;

        if (this._where) {
            query = sql`${query} WHERE ${expressionToSql(sql, this._where)}`;
        }

        if (this._returning.length > 0) {
            const colNames = this._returning.map(c => typeof c === 'string' ? c : c.name).join(', ');
            query = sql`${query} RETURNING ${sql.unsafe(colNames)}`;
        }

        return query;
    }
}

class DeleteBuilder extends QueryBuilder {
    private _where?: FSql;
    private _using?: FTable;
    private _returning: Array<FColumn<any> | string> = [];

    where(condition: FSql) { this._where = condition; return this; }
    using(table: FTable) { this._using = table; return this; }
    returning(...columns: Array<FColumn<any> | string>) { this._returning.push(...columns); return this; }

    toSql(): postgres.PendingQuery<any> {
        let sql = this._table._orm._sql;

        let query = sql`DELETE FROM ${sql.unsafe(this._table.$$name)}`;

        if (this._using) {
            query = sql`${query} USING ${sql.unsafe(this._using.$$name)}`;
        }

        if (this._where) {
            query = sql`${query} WHERE ${expressionToSql(sql, this._where)}`;
        }

        if (this._returning.length > 0) {
            const colNames = this._returning.map(c => typeof c === 'string' ? c : c.name).join(', ');
            query = sql`${query} RETURNING ${sql.unsafe(colNames)}`;
        }

        return query;
    }
}


