{{- if or .Nullable .HasDefault}}
        if (obj.{{.ColName}} !== undefined && obj.{{.ColName}} !== null) {
            if (!(obj.{{.ColName}} instanceof Date) && typeof obj.{{.ColName}} !== 'string') {
                throw new Error("{{.ColName}} must be a Date object or ISO date string");
            }
        }
{{else}}
        if (obj.{{.ColName}} === undefined || obj.{{.ColName}} === null) {
            throw new Error("{{.ColName}} is required");
        }
        
        if (!(obj.{{.ColName}} instanceof Date) && typeof obj.{{.ColName}} !== 'string') {
            throw new Error("{{.ColName}} must be a Date object or ISO date string");
        }
{{- end}}
